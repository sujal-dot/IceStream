# ==============================================================================
# IceStream Environment Variables Template
# ==============================================================================
# NOTICE: This file contains configuration placeholders ONLY.
# Do NOT put actual production credentials or real secrets in this template file.
# Copy this file to '.env' for local development configuration:
#   cp .env.example .env
# ==============================================================================

# General Project Configuration
PROJECT_NAME=icestream
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & API Authentication (Required for control endpoints)
ICESTREAM_API_TOKEN=change-me-api-token-secret

# Apache Kafka Infrastructure Configuration (KRaft Mode)
KAFKA_BROKER_ID=1
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=checkout-events
KAFKA_QUARANTINE_TOPIC=quarantine-events

# MinIO (S3-Compatible Object Storage) Configuration
MINIO_ROOT_USER=icestream_minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_ACCESS_KEY=icestream_minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1
MINIO_BUCKET=warehouse

# PostgreSQL Metadata Database Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=icestream_db
POSTGRES_USER=icestream_user
POSTGRES_PASSWORD=change-me-postgres-secret

# Apache Flink Cluster Configuration
FLINK_JOB_MANAGER_HOST=flink-jobmanager
FLINK_JOB_MANAGER_PORT=8081
FLINK_PARALLELISM=2

# Apache Iceberg Catalog Configuration
ICEBERG_CATALOG_NAME=icestream
ICEBERG_CATALOG_TYPE=rest
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_REST_URI_INTERNAL=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://warehouse/

# Prometheus & Grafana Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Quality Engine & Circuit Breaker Thresholds
QUALITY_ERROR_RATE_THRESHOLD=0.02
CIRCUIT_BREAKER_WINDOW_SECONDS=300
CIRCUIT_BREAKER_MIN_EVENTS=10
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Observability Backend API (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Dashboard (React + Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_ICESTREAM_API_TOKEN=change-me-api-token-secret

# Alerting Integrations
SLACK_WEBHOOK_URL=
SLACK_ALERTS_ENABLED=false
