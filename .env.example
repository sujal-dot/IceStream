# ==============================================================================
# IceStream Environment Variables Template
# ==============================================================================
# NOTICE: This file contains configuration placeholders ONLY.
# Do NOT put actual credentials, secrets, or passwords in this template file.
# Copy this file to '.env' for local development configuration.
# ==============================================================================

# General Project Configuration
PROJECT_NAME=icestream
ENVIRONMENT=development
LOG_LEVEL=INFO

# Python Event Simulator Configuration
SIMULATOR_EVENTS_PER_SECOND=100
SIMULATOR_ANOMALY_RATE=0.05
SIMULATOR_SEED=42

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=raw-events
KAFKA_QUARANTINE_TOPIC=quarantine-events
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Apache Flink Configuration
FLINK_JOB_MANAGER_HOST=localhost
FLINK_JOB_MANAGER_PORT=8081
FLINK_PARALLELISM=2

# PostgreSQL Configuration (Metadata, Incidents, Audit)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=icestream_db
POSTGRES_USER=icestream_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# MinIO (S3-Compatible Storage for Apache Iceberg)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=warehouse

# Apache Iceberg Catalog Configuration
ICEBERG_CATALOG_NAME=demo
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE_PATH=s3a://warehouse/iceberg/

# Quality Engine & Circuit Breaker Thresholds
QUALITY_ERROR_RATE_THRESHOLD=0.05
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_MIN_EVENTS=100
CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

# Observability Backend (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend Dashboard (React + React Flow)
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_WS_URL=ws://localhost:8000/ws

# Monitoring (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# Alerting Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
