# ==============================================================================
# IceStream Environment Variables Template
# ==============================================================================
# NOTICE: This file contains configuration placeholders ONLY.
# Do NOT put actual credentials, secrets, or passwords in this template file.
# Copy this file to '.env' for local development configuration.
# ==============================================================================

# General Project Configuration
PROJECT_NAME=icestream
ENVIRONMENT=development
LOG_LEVEL=INFO

# Apache Kafka Infrastructure Configuration (KRaft Mode)
KAFKA_BROKER_ID=1
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=raw-events
KAFKA_QUARANTINE_TOPIC=quarantine-events

# MinIO (S3-Compatible Object Storage) Configuration
MINIO_ROOT_USER=icestream_minio
MINIO_ROOT_PASSWORD=icestream_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=icestream_minio
MINIO_SECRET_KEY=icestream_minio_secret
MINIO_BUCKET=warehouse

# PostgreSQL Metadata Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=icestream_db
POSTGRES_USER=icestream_user
POSTGRES_PASSWORD=icestream_password

# Apache Flink Cluster Configuration
FLINK_JOB_MANAGER_HOST=flink-jobmanager
FLINK_JOB_MANAGER_PORT=8081
FLINK_PARALLELISM=2

# Apache Iceberg Catalog Configuration (Phase 3 Target)
ICEBERG_CATALOG_NAME=demo
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE_PATH=s3a://warehouse/iceberg/

# Prometheus & Grafana Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Quality Engine & Circuit Breaker Thresholds (Phase 4 Target)
QUALITY_ERROR_RATE_THRESHOLD=0.05
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_MIN_EVENTS=100
CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

# Observability Backend API (FastAPI - Phase 5 Target)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend Dashboard (React + React Flow - Phase 5 Target)
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_WS_URL=ws://localhost:8000/ws

# Alerting Integrations (Phase 4 Target)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
