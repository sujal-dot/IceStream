{
  "schema_version": "v3",
  "description": "Breaking IceStream Checkout Event Schema with type change amount: float -> string",
  "fields": {
    "event_id": {
      "type": "string",
      "required": true
    },
    "event_time": {
      "type": "timestamp",
      "required": true
    },
    "event_type": {
      "type": "string",
      "required": true
    },
    "customer_id": {
      "type": "string",
      "required": true
    },
    "session_id": {
      "type": "string",
      "required": true
    },
    "order_id": {
      "type": "string",
      "required": true
    },
    "product_id": {
      "type": "string",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "required": true
    },
    "unit_price": {
      "type": "float",
      "required": true
    },
    "amount": {
      "type": "string",
      "required": true
    },
    "currency": {
      "type": "string",
      "required": true
    },
    "payment_method": {
      "type": "string",
      "required": true,
      "enum": [
        "UPI",
        "CREDIT_CARD",
        "DEBIT_CARD",
        "NET_BANKING",
        "WALLET",
        "COD"
      ]
    },
    "payment_status": {
      "type": "string",
      "required": true,
      "enum": [
        "SUCCESS",
        "FAILED",
        "PENDING",
        "REFUNDED"
      ]
    },
    "device": {
      "type": "string",
      "required": true
    },
    "device_model": {
      "type": "string",
      "required": false
    },
    "country": {
      "type": "string",
      "required": true
    },
    "coupon_code": {
      "type": "string",
      "required": false
    },
    "source": {
      "type": "string",
      "required": true
    },
    "source_version": {
      "type": "string",
      "required": true
    }
  }
}
